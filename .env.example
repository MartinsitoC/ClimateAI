# ==============================================================================
# URBAN-HEAT GRID INTELLIGENCE — Configuración de Entorno (.env.example)
# ==============================================================================
# NOTA IMPORTANTE SOBRE SERVICIOS EXTERNOS:
# Las APIs externas integradas en este sistema son públicas y abiertas, por lo
# que NO requieren API keys ni credenciales de pago para operar:
#   1. Open-Meteo Forecast API (https://api.open-meteo.com/v1/forecast) -> Sin API Key
#   2. Open-Meteo ERA5 Historical Archive (https://archive-api.open-meteo.com) -> Sin API Key
#   3. OpenStreetMap Nominatim Geocoding (https://nominatim.openstreetmap.org) -> Sin API Key
# ==============================================================================

# Configuración opcional del servidor FastAPI / Uvicorn
APP_HOST=127.0.0.1
APP_PORT=8080
SYSTEM_DEFAULT_MODE=demo
LOG_LEVEL=info
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
